# ─── Variáveis de ambiente do backend ────────────────────────────────────────
#
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
# O arquivo .env nunca deve ser commitado no repositório.
#
# Como usar:
#   Linux/macOS : export $(cat .env | xargs) && uvicorn main:app
#   Windows PS  : Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }

# Origens permitidas pelo CORS (separadas por vírgula, sem espaços).
# Use * apenas em desenvolvimento local. Em produção, liste as origens exatas.
#   Desenvolvimento : ALLOWED_ORIGINS=*
#   Produção        : ALLOWED_ORIGINS=https://meusite.com,https://www.meusite.com
ALLOWED_ORIGINS=*

# Porta em que o servidor backend escuta (padrão uvicorn: 8000).
# Passe diretamente ao iniciar: uvicorn main:app --port 8080
# PORT=8000
